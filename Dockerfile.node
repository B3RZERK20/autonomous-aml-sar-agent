# ==============================================================================
# Node.js API Gateway & React Frontend
# ==============================================================================

# Stage 1: Build React JSX Frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Production Node.js Gateway
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NODE_PORT=5000

# Install Node gateway dependencies
COPY backend-node/package*.json ./backend-node/
WORKDIR /app/backend-node
RUN npm ci --only=production

# Copy backend source
COPY backend-node/src/ ./src/

# Copy built React frontend bundle from Stage 1
COPY --from=frontend-builder /app/frontend/dist /app/frontend/dist

EXPOSE 5000

CMD ["node", "src/server.js"]
