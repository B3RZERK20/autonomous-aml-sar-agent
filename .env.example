# ===================================================
# AML Autonomous Investigation & SAR Agent Environment
# ===================================================

# LLM Provider Configuration (Groq - Free Tier)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Node.js API Gateway Configuration
NODE_PORT=5000
PYTHON_AI_URL=http://127.0.0.1:8000

# MCP Server Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001

# Observability Configuration (Arize Phoenix - Free & Local)
# Runs natively on http://localhost:6006 with zero API keys required
PHOENIX_ENABLE=true
PHOENIX_PORT=6006

# Storage Paths
DATABASE_PATH=data/database/aml_transactions.db
CHROMA_PERSIST_DIR=data/processed/chroma
REGULATORY_DOCS_DIR=data/raw/regulations
