# ==============================================================================
# Python AI Core Microservice (LangGraph, MCP Server, Chroma RAG, FastAPI)
# Optimized with Astral uv (10-100x faster than standard pip) & CPU wheels
# ==============================================================================
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONUTF8=1
ENV UV_SYSTEM_PYTHON=1

WORKDIR /app

# Install curl for healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy high-speed uv binary from official Astral image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install dependencies using uv with CPU torch wheel index (saves 2.3+ GB of CUDA bloat)
COPY requirements.txt .
RUN uv pip install --system \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements.txt

# Copy source code and regulatory corpus
COPY agents/ ./agents/
COPY api/ ./api/
COPY data/raw/ ./data/raw/
COPY mcp_server/ ./mcp_server/
COPY observability/ ./observability/
COPY rag/ ./rag/
COPY tests/ ./tests/
COPY .env.example .

# Expose FastAPI (8000) and Arize Phoenix (6006)
EXPOSE 8000 6006

# Startup script to seed SQLite, index Chroma, and launch FastAPI
CMD ["sh", "-c", "python mcp_server/mock_db.py && python rag/vector_store.py && uvicorn api.main:app --host 0.0.0.0 --port 8000"]
